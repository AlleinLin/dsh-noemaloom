  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1",
    "dsh": "0.2.1-rc.3"
  },
  "packageManager": "npm@11.19.1",
  "exports": {
    ".": "./lib/index.js",
    "./compaction": "./lib/compaction.js",
    "./preset-runtime": "./lib/preset-runtime.js",
    "./project-rules": "./lib/project-rules.js",
    "./subagent": "./lib/subagent.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./original/*": "./lib/original/*.js",
    "./native/*": "./lib/native/*.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "cordis.presets.patch.yml",
    "locale",
    "assets",
    "vendor/memory-cognition",
    "vendor/memsearch",
    "vendor/codinput",
    "vendor/computer-use",
    "vendor/agent-instructions/LICENSE",
    "vendor/agent-instructions/SOURCE.json",
    "vendor/tool-subagent/LICENSE",
    "vendor/tool-subagent/SOURCE.json",
    "vendor/agent-procedures/LICENSE",
    "vendor/agent-procedures/SOURCE.json",
    "vendor/nexus-terminal/LICENSE",
    "vendor/nexus-terminal/SOURCE.json",
    "vendor/compaction-basic/LICENSE",
    "vendor/compaction-basic/SOURCE.json",
    "notices",
    "sources.lock.json",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE-ORIGINAL",
    "upstreams.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "check": "npm run build && npm run typecheck && npm run test && npm run verify:artifacts",
    "audit:security": "npm audit --audit-level=low",
    "pack:delivery": "npm run audit:security && node scripts/package-delivery.mjs",
    "acceptance:report": "node scripts/acceptance-report.mjs",
    "acceptance:debug": "node scripts/acceptance-debug.mjs",
    "upstreams:check": "node scripts/check-upstreams.mjs --output upstream-report.json"
  },
